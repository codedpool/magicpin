# magicpin AI Challenge — Vera Bot
# Copy this file to .env and fill in real values.
# .env is gitignored. NEVER commit real credentials.

# ─── Groq LLM ────────────────────────────────────────────────────────────────
# Get from https://console.groq.com/keys (free tier)
GROQ_API_KEY=gsk_REPLACE_ME
# Optional: additional accounts' keys. Round-robined for N× effective TPM.
GROQ_API_KEY_BACKUP=
GROQ_API_KEY_TERTIARY=

# ─── Supabase Postgres (state persistence) ───────────────────────────────────
# Get from https://supabase.com/dashboard/project/<project>/settings/database
# Use the "Connection string" → URI mode → replace [YOUR-PASSWORD] with the db password
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_DB_HOST=db.REPLACE_ME.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=REPLACE_ME
SUPABASE_DB_NAME=postgres

# Service-role key (Settings → API → service_role — NOT the anon key)
SUPABASE_SERVICE_KEY=REPLACE_ME

# ─── Vera Console admin auth (for /admin/* endpoints) ────────────────────────
ADMIN_PASSWORD=choose_a_strong_password

# ─── Bot identity (returned by /v1/metadata) ─────────────────────────────────
BOT_TEAM_NAME=Solo Submission
BOT_VERSION=0.1.0
BOT_CONTACT_EMAIL=romanchroshansingh@gmail.com

# ─── Runtime tuning ──────────────────────────────────────────────────────────
# Hard deadline for /v1/tick processing (seconds). Judge timeout is 30s.
TICK_DEADLINE_SECONDS=25
# Hard deadline for /v1/reply processing (seconds).
REPLY_DEADLINE_SECONDS=20
# Max parallel compose() calls inside a single /v1/tick.
TICK_CONCURRENCY=8
# Cadence guard: refuse new send to same merchant if last send within this window.
CADENCE_GUARD_HOURS=4
# Suppression TTL: refuse re-send of same suppression_key within this window.
SUPPRESSION_TTL_DAYS=7
# Block TTL: refuse all sends to merchant after hostile reply.
BLOCK_TTL_DAYS=30

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Persistence (Phase C+) ──────────────────────────────────────────────────
# Set to true to enable Supabase write-through; false runs pure in-memory.
SUPABASE_ENABLED=true
